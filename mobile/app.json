{
  "expo": {
    "name": "Rumr",
    "slug": "rumr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "owner": "thakurcodeshere",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#070707"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thakurcodeshere.rumr"
    },
    "android": {
      "package": "com.thakurcodeshere.rumr",
      "adaptiveIcon": {
        "backgroundColor": "#070707"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "webAppUrl": "https://rumr-sigma.vercel.app"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
