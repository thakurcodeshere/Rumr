# ==========================================================
# RUMR PRODUCTION STACK ENVIRONMENT CONFIGURATION
# ==========================================================

# 1. Core Runtime & Server
PORT=3001
NODE_ENV=production
JWT_SECRET=rumr-cryptographic-mesh-secret-key-2026-dpdp-ready

# 2. Primary Database & Auth (Supabase PostgreSQL)
# Project ID: hjqkfxwkfctrivfftmwv
SUPABASE_URL=https://hjqkfxwkfctrivfftmwv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_9rLauMh7QrTGWzhRs9ALTA_oS04TtkZ
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. WebRTC Audio Infrastructure (LiveKit Cloud)
LIVEKIT_URL=wss://rumr-mesh.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# 4. Presence & Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 5. Scheduled & Background Jobs (Upstash QStash)
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# 6. Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="RUMR Sentinel <onboarding@resend.dev>"

# 7. Crash & Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# 8. Frontend & Edge Hosting (Vercel)
VERCEL=1
VERCEL_ENV=production

# 9. DNS, CDN & Edge Security (Cloudflare)
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
